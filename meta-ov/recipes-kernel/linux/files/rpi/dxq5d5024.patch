+	mipi_dsi_generic_write(dsi, (u8[]){0xCB,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},9);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x90},2);	// power on 1	CB90
+	mipi_dsi_generic_write(dsi, (u8[]){0xCB,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},16);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xA0},2);	// power on 2	CBA0
