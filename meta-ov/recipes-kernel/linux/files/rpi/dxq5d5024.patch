+#include <drm/drm_panel.h>
+
+static const char * const regulator_names[] = {
+	"vddp",
+	"iovcc"
+};
+
+struct dxq_panel {
+	struct drm_panel base;
+	struct mipi_dsi_device *dsi;
+
+	struct regulator_bulk_data supplies[ARRAY_SIZE(regulator_names)];
+
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *dcdc_en_gpio;
+	struct backlight_device *backlight;
+
+	bool prepared;
+	bool enabled;
+
+	const struct drm_display_mode *mode;
+};
+
+static inline struct dxq_panel *to_dxq_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct dxq_panel, base);
+}
+
+static int dxq_panel_init(struct dxq_panel *dxq)
+{
+	struct mipi_dsi_device *dsi = dxq->dsi;
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_soft_reset(dsi);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(10000, 20000);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x01},1);
+	usleep_range(10000, 20000);
+
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x00},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xFF,0x87,0x36,0x01},4);
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x80},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xFF,0x87,0x36},3);
+
+
+	// C090H CKH vdo cmd timing setting
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x90},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC0,0x00,0x00,0x05,0x05,0x05,0x05,0x06,0x06,0x01,0x01,0x17,0x17,0x05,0x05}, 15);
+
+
+	// CE80H CKH re pre scan timing setting
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xB0},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xCE,0x00,0x05,0x05,0x06,0x01,0x2E,0x05,0x00,0x05,0x05,0x06,0x01,0x18,0x05}, 15);
+
+
+	// C280 C2B0 VST & CLK setting
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x80},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x82,0x00,0x12,0x00,0x81,0x00,0x12,0x00},9);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xB0},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x00,0x08,0x00,0x12,0x81,0x01,0x09,0x00,0x12,0x81,0x02,0x0A,0x00,0x12,0x81},16);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xC0},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x03,0x0B,0x00,0x12,0x81,0x04,0x04,0x00,0x12,0x81,0x05,0x05,0x00,0x12,0x81},16);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xD0},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x06,0x06,0x00,0x12,0x81,0x07,0x07,0x00,0x12,0x81},11);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xDA},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x77,0x77,0x77,0x77},5);
+
+
+	// C3C0H CKV auto det setting
