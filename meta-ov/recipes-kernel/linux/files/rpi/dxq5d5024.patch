+	//-------------------20160216---------------------------
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x83},2);				//CKV EQ 20161107
+	mipi_dsi_generic_write(dsi, (u8[]){0xC3,0x22,0x22},3);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x88},2);				//CKH EQ 20161107
+	mipi_dsi_generic_write(dsi, (u8[]){0xC3,0x33,0x33},3);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x98},2);				//CKH EQ 20161107
+	mipi_dsi_generic_write(dsi, (u8[]){0xC3,0x33,0x33},3);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x80},2);				//FRC & Dgamma enable 20160312
+	mipi_dsi_generic_write(dsi, (u8[]){0xD7,0x04},2);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x80},2); 				// 20160220
+	mipi_dsi_generic_write(dsi, (u8[]){0xC4,0x11},2);
+
+	//-------------------20160312---------------------------
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xD0},2);				//SMP 20160312
+	mipi_dsi_generic_write(dsi, (u8[]){0xF4,0x2A,0x2A},3);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xF5},2);				//cap_ctrl 20160312
+	mipi_dsi_generic_write(dsi, (u8[]){0xF5,0x53},2);
+
+	//-------------------20160409---------------------------
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x93},2);				//Source clk dly 20160409
+	mipi_dsi_generic_write(dsi, (u8[]){0xC4,0x22},2);
+
+	//-------------------20160413---------------------------
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xF4},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x83,0x02,0xD0},4);
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xF8},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xC2,0x80},2);
+
+	//-------------------20161104---------------------------
+	//Gamma & SDOP en
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xA7},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xF3,0x03},2);
+
+	//ESD
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xA6},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xF3,0x01},2);
+
+	//-------------------20161221---------------------------
+	// F5D5H
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xD5},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xF5,0x21},2);
+
+	//-------------------20161104---------------------------
+	//Gamma
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x00},2); //2.2+
+	mipi_dsi_generic_write(dsi, (u8[]){0xE1,0x0D,0x14,0x28,0x3B,0x45,0x53,0x65,0x73,0x78,0x81,0x88,0x8F,0x6B,0x67,0x66,0x62,0x56,0x4B,0x3C,0x33,0x2B,0x1E,0x18,0x17},25);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x00},2); //2.2-
+	mipi_dsi_generic_write(dsi, (u8[]){0xE2,0x0D,0x14,0x28,0x3B,0x45,0x53,0x65,0x73,0x78,0x81,0x88,0x8F,0x6B,0x67,0x66,0x62,0x56,0x4B,0x3C,0x33,0x2B,0x1E,0x0A,0x09},25);
+
+	//CMD2 DISABLE
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x00},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xff,0x00,0x00,0x00},4);
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x80},2);
+	mipi_dsi_generic_write(dsi, (u8[]){0xff,0x00,0x00},3);
+
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x11},1);
+	usleep_range(10000, 20000);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x29},1);
+	mipi_dsi_generic_write(dsi, (u8[]){0x35},1); //TE
+
+
+
+
+
+	ret = mipi_dsi_dcs_set_pixel_format(dsi, MIPI_DCS_PIXEL_FMT_24BIT << 4);
+	if (ret < 0) {
+		dev_err(dev, "failed to set pixel format: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_dcs_set_column_address(dsi, 0, dxq->mode->hdisplay - 1);
+	if (ret < 0) {
+		dev_err(dev, "failed to set column address: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_dcs_set_page_address(dsi, 0, dxq->mode->vdisplay - 1);
+	if (ret < 0) {
+		dev_err(dev, "failed to set page address: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * BIT(5) BCTRL = 1 Backlight Control Block On, Brightness registers
+	 *                  are active
+	 * BIT(3) BL = 1    Backlight Control On
+	 * BIT(2) DD = 0    Display Dimming is Off
+	 */
+	ret = mipi_dsi_dcs_write(dsi, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				 (u8[]){ 0x24 }, 1);
+	if (ret < 0) {
+		dev_err(dev, "failed to write control display: %d\n", ret);
+		return ret;
+	}
+
+	/* CABC off */
+	ret = mipi_dsi_dcs_write(dsi, MIPI_DCS_WRITE_POWER_SAVE,
+				 (u8[]){ 0x00 }, 1);
+	if (ret < 0) {
+		dev_err(dev, "failed to set cabc off: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to set exit sleep mode: %d\n", ret);
+		return ret;
+	}
+
+	msleep(120);
+
+	ret = mipi_dsi_generic_write(dsi, (u8[]){0xB0, 0x00}, 2);
+	if (ret < 0) {
+		dev_err(dev, "failed to set mcap: %d\n", ret);
+		return ret;
+	}
+
+	mdelay(10);
+
+	/* Interface setting, video mode */
+	ret = mipi_dsi_generic_write(dsi, (u8[])
+				     {0xB3, 0x26, 0x08, 0x00, 0x20, 0x00}, 6);
+	if (ret < 0) {
+		dev_err(dev, "failed to set display interface setting: %d\n"
+			, ret);
+		return ret;
+	}
+
+	mdelay(20);
+
+	ret = mipi_dsi_generic_write(dsi, (u8[]){0xB0, 0x03}, 2);
+	if (ret < 0) {
+		dev_err(dev, "failed to set default values for mcap: %d\n"
+			, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int dxq_panel_on(struct dxq_panel *dxq)
+{
+	struct mipi_dsi_device *dsi = dxq->dsi;
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0)
+		dev_err(dev, "failed to set display on: %d\n", ret);
+
+	return ret;
+}
+
+static void dxq_panel_off(struct dxq_panel *dxq)
+{
+	struct mipi_dsi_device *dsi = dxq->dsi;
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0)
+		dev_err(dev, "failed to set display off: %d\n", ret);
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	if (ret < 0)
+		dev_err(dev, "failed to enter sleep mode: %d\n", ret);
+
+	msleep(100);
+}
+
+static int dxq_panel_disable(struct drm_panel *panel)
+{
+	struct dxq_panel *dxq = to_dxq_panel(panel);
+
+	if (!dxq->enabled)
+		return 0;
+
+	backlight_disable(dxq->backlight);
+
+	dxq->enabled = false;
+
+	return 0;
+}
+
+static int dxq_panel_unprepare(struct drm_panel *panel)
+{
+	struct dxq_panel *dxq = to_dxq_panel(panel);
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+
+	if (!dxq->prepared)
+		return 0;
+
+	dxq_panel_off(dxq);
+
+	ret = regulator_bulk_disable(ARRAY_SIZE(dxq->supplies), dxq->supplies);
+	if (ret < 0)
+		dev_err(dev, "regulator disable failed, %d\n", ret);
+
+	gpiod_set_value_cansleep(dxq->enable_gpio, 0);
+
+	gpiod_set_value_cansleep(dxq->reset_gpio, 1);
+
+	gpiod_set_value_cansleep(dxq->dcdc_en_gpio, 0);
+
+	dxq->prepared = false;
+
+	return 0;
+}
+
+static int dxq_panel_prepare(struct drm_panel *panel)
+{
+	struct dxq_panel *dxq = to_dxq_panel(panel);
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+
+	if (dxq->prepared)
+		return 0;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(dxq->supplies), dxq->supplies);
+	if (ret < 0) {
+		dev_err(dev, "regulator enable failed, %d\n", ret);
+		return ret;
+	}
+
+	msleep(20);
+
+	gpiod_set_value_cansleep(dxq->dcdc_en_gpio, 1);
+	usleep_range(10, 20);
+
+	gpiod_set_value_cansleep(dxq->reset_gpio, 0);
+	usleep_range(10, 20);
+
+	gpiod_set_value_cansleep(dxq->enable_gpio, 1);
+	usleep_range(10, 20);
+
+	ret = dxq_panel_init(dxq);
+	if (ret < 0) {
+		dev_err(dev, "failed to init panel: %d\n", ret);
+		goto poweroff;
+	}
+
+	ret = dxq_panel_on(dxq);
+	if (ret < 0) {
+		dev_err(dev, "failed to set panel on: %d\n", ret);
+		goto poweroff;
+	}
+
+	dxq->prepared = true;
+
+	return 0;
+
+poweroff:
+	ret = regulator_bulk_disable(ARRAY_SIZE(dxq->supplies), dxq->supplies);
+	if (ret < 0)
+		dev_err(dev, "regulator disable failed, %d\n", ret);
+
+	gpiod_set_value_cansleep(dxq->enable_gpio, 0);
+
+	gpiod_set_value_cansleep(dxq->reset_gpio, 1);
+
+	gpiod_set_value_cansleep(dxq->dcdc_en_gpio, 0);
+
+	return ret;
+}
+
+static int dxq_panel_enable(struct drm_panel *panel)
+{
+	struct dxq_panel *dxq = to_dxq_panel(panel);
+
+	if (dxq->enabled)
+		return 0;
+
+	backlight_enable(dxq->backlight);
+
+	dxq->enabled = true;
+
+	return 0;
+}
+
+static const struct drm_display_mode default_mode = {
+		.clock = 140000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 16,
+		.hsync_end = 1080 + 16 + 45,
+		.htotal = 1080 + 16 + 45 + 40,
+		.vdisplay = 1920,
+		.vsync_start = 1920 + 4,
+		.vsync_end = 1920 + 4 + 18,
+		.vtotal = 1920 + 4 + 18 + 18,
+		.flags = 0,
+};
+
+static int dxq_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	struct dxq_panel *dxq = to_dxq_panel(panel);
+	struct device *dev = &dxq->dsi->dev;
+
+	mode = drm_mode_duplicate(connector->dev, &default_mode);
+	if (!mode) {
+		dev_err(dev, "failed to add mode %ux%ux@%u\n",
+			default_mode.hdisplay, default_mode.vdisplay,
+			drm_mode_vrefresh(&default_mode));
+		return -ENOMEM;
+	}
+
+	drm_mode_set_name(mode);
+
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = 95;
+	connector->display_info.height_mm = 151;
+
+	return 1;
+}
+
+static int dsi_dcs_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	int ret;
+	u16 brightness = bl->props.brightness;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness & 0xff;
+}
+
+static int dsi_dcs_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness(dsi, bl->props.brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static const struct backlight_ops dsi_bl_ops = {
+	.update_status = dsi_dcs_bl_update_status,
+	.get_brightness = dsi_dcs_bl_get_brightness,
+};
+
+static struct backlight_device *
+drm_panel_create_dsi_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props;
+
+	memset(&props, 0, sizeof(props));
+	props.type = BACKLIGHT_RAW;
+	props.brightness = 255;
+	props.max_brightness = 255;
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &dsi_bl_ops, &props);
+}
+
+static const struct drm_panel_funcs dxq_panel_funcs = {
+	.disable = dxq_panel_disable,
+	.unprepare = dxq_panel_unprepare,
+	.prepare = dxq_panel_prepare,
+	.enable = dxq_panel_enable,
+	.get_modes = dxq_panel_get_modes,
+};
+
+static const struct of_device_id dxq_of_match[] = {
+	{ .compatible = "dxq,dxq5d5024", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dxq_of_match);
+
+static int dxq_panel_add(struct dxq_panel *dxq)
+{
+	struct device *dev = &dxq->dsi->dev;
+	int ret;
+	unsigned int i;
+
+	dxq->mode = &default_mode;
+
+	for (i = 0; i < ARRAY_SIZE(dxq->supplies); i++)
+		dxq->supplies[i].supply = regulator_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(dxq->supplies),
+				      dxq->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "failed to init regulator, ret=%d\n", ret);
+
+	dxq->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(dxq->enable_gpio)) {
+		return dev_err_probe(dev, PTR_ERR(dxq->enable_gpio),
+				     "cannot get enable-gpio %d\n", ret);
+	}
+
+	dxq->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(dxq->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(dxq->reset_gpio),
+				     "cannot get reset-gpios %d\n", ret);
+
+	dxq->dcdc_en_gpio = devm_gpiod_get(dev, "dcdc-en", GPIOD_OUT_LOW);
+	if (IS_ERR(dxq->dcdc_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(dxq->dcdc_en_gpio),
+				     "cannot get dcdc-en-gpio %d\n", ret);
+
+	dxq->backlight = drm_panel_create_dsi_backlight(dxq->dsi);
+	if (IS_ERR(dxq->backlight))
+		return dev_err_probe(dev, PTR_ERR(dxq->backlight),
+				     "failed to register backlight %d\n", ret);
+
+	dxq->base.prepare_prev_first = true;
+	drm_panel_init(&dxq->base, &dxq->dsi->dev, &dxq_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	drm_panel_add(&dxq->base);
+
+	return 0;
+}
+
+static void dxq_panel_del(struct dxq_panel *dxq)
+{
+	if (dxq->base.dev)
+		drm_panel_remove(&dxq->base);
+}
+
+static int dxq_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct dxq_panel *dxq;
+	int ret;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags =  MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			MIPI_DSI_MODE_VIDEO_BURST;
+
+	dxq = devm_kzalloc(&dsi->dev, sizeof(*dxq), GFP_KERNEL);
+	if (!dxq)
+		return -ENOMEM;
+
+	mipi_dsi_set_drvdata(dsi, dxq);
+
+	dxq->dsi = dsi;
+
+	ret = dxq_panel_add(dxq);
+	if (ret < 0)
+		return ret;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dxq_panel_del(dxq);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void dxq_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct dxq_panel *dxq = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = dxq_panel_disable(&dxq->base);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to disable panel: %d\n", ret);
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n",
+			ret);
+
+	dxq_panel_del(dxq);
+}
+
+static void dxq_panel_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct dxq_panel *dxq = mipi_dsi_get_drvdata(dsi);
+
+	dxq_panel_disable(&dxq->base);
+}
+
+static struct mipi_dsi_driver dxq_panel_driver = {
+	.driver = {
+		.name = "panel-dxq5d5024",
+		.of_match_table = dxq_of_match,
+	},
+	.probe = dxq_panel_probe,
+	.remove = dxq_panel_remove,
+	.shutdown = dxq_panel_shutdown,
+};
+module_mipi_dsi_driver(dxq_panel_driver);
