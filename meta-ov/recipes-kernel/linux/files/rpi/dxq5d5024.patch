+	mipi_dsi_generic_write(dsi, (u8[]){0xCD,0x22,0x22,0x22,0x01,0x22,0x09,0x07,0x05,0x03,0x13,0x14,0x22,0x10,0x11,0x12},16);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x90},2);	// CGOUT R 2	CD90
+	mipi_dsi_generic_write(dsi, (u8[]){0xCD,0x0D,0x0E,0x0F},4);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xA0},2);	// CGOUT L 1	CDA0
+	mipi_dsi_generic_write(dsi, (u8[]){0xCD,0x22,0x22,0x22,0x02,0x22,0x0A,0x08,0x06,0x04,0x13,0x14,0x22,0x10,0x11,0x12},16);
+
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0xB0},2);	// CGOUT L 2	CDB0
+	mipi_dsi_generic_write(dsi, (u8[]){0xCD,0x0D,0x0E,0x0F},4);
+
+
+	// F381H All gate on off setting
+	mipi_dsi_generic_write(dsi, (u8[]){0x00,0x81},2);	// All gate on off	F381
